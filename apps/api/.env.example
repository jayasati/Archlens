NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://archlens:archlens@localhost:5433/archlens?schema=public
# Required only when DATABASE_URL is a pooled connection (Neon, Supabase, etc.)
# For local Docker Postgres, leave unset.
DIRECT_DATABASE_URL=

REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

GITHUB_CLIENT_ID=set-me
GITHUB_CLIENT_SECRET=set-me
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

WEB_APP_URL=http://localhost:3000
