{
  "name": "@archlens/web",
  "version": "0.0.0",
  "private": true,
  "description": "Archlens Next.js frontend",
  "scripts": {
    "dev": "next dev --turbo -p 3000",
    "dev:webpack": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint --no-error-on-unmatched-pattern",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .next .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@archlens/ir-schema": "workspace:*",
    "@archlens/shared-types": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@tanstack/react-query": "^5.62.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cytoscape": "^3.30.4",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.4.1",
    "next": "14.2.18",
    "next-auth": "^4.24.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^2.13.3",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
