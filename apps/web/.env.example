# Public — exposed to the browser
NEXT_PUBLIC_API_URL=http://localhost:3001

# NextAuth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-me-with-openssl-rand-base64-32

# GitHub OAuth (for NextAuth's GitHub provider on the web side).
# Can reuse the same app you use for the API, or a separate one.
GITHUB_ID=
GITHUB_SECRET=

# Server-side URL the web app uses to call the Archlens API
# (token exchange, repos list, scans, etc.).
ARCHLENS_API_URL=http://localhost:3001
