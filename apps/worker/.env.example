NODE_ENV=development

DATABASE_URL=postgresql://archlens:archlens@localhost:5433/archlens?schema=public
DIRECT_DATABASE_URL=

REDIS_URL=redis://localhost:6379

# Per-job temp dir for cloning. Default: <os.tmpdir>/archlens-scans
SCAN_TMP_DIR=

# Where the IR JSON for each scan is persisted. Default: /var/lib/archlens/reports
# (Windows: <os.tmpdir>/archlens-reports)
IR_REPORTS_DIR=

WORKER_CONCURRENCY=2
