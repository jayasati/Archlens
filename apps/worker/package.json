{
  "name": "@archlens/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Archlens background scan runner (Nest standalone app)",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "test": "echo \"no unit tests yet\" && exit 0",
    "test:integration": "jest --config jest-integration.config.js --runInBand",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist .turbo *.tsbuildinfo",
    "prisma:generate": "prisma generate --schema=../api/prisma/schema.prisma"
  },
  "dependencies": {
    "@archlens/analyzers": "workspace:*",
    "@archlens/ir-schema": "workspace:*",
    "@archlens/shared-types": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "simple-git": "^3.27.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "typescript": "^5.7.2"
  }
}
