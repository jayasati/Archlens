{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "rootDir": ".",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "types": ["node"]
  },
  "include": ["src/**/*", "test/**/*", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "build", "coverage", "test/fixtures/**", "../../tools/**"]
}
