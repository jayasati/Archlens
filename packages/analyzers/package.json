{
  "name": "@archlens/analyzers",
  "version": "0.0.0",
  "private": true,
  "description": "Language adapters and metric/scoring engines as a library",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "archlens-analyze": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b && node ./scripts/link-bin.cjs",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "analyze": "node ./dist/cli.js",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@archlens/ir-schema": "workspace:*",
    "@archlens/shared-types": "workspace:*",
    "commander": "^13.0.0",
    "graphology": "^0.26.0",
    "graphology-types": "^0.24.7",
    "tree-sitter-wasms": "^0.1.12",
    "web-tree-sitter": "^0.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "vitest": "^2.1.8"
  }
}
