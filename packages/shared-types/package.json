{
  "name": "@archlens/shared-types",
  "version": "0.0.0",
  "private": true,
  "description": "Shared DTOs and domain types between api, web, and worker",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@archlens/ir-schema": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
